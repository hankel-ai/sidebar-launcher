<Window x:Class="SidebarLauncher.EditShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Shortcut"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="360" Height="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#E6181818" CornerRadius="8"
            BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" Opacity="0.4" ShadowDepth="2" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <TextBlock Grid.Row="0" Text="Add Shortcut" FontSize="16" FontWeight="SemiBold"
                       Foreground="#CCCCCC"/>

            <!-- Name -->
            <TextBlock Grid.Row="2" Text="Name" Foreground="#999999" FontSize="12"/>
            <TextBox Grid.Row="4" x:Name="NameBox"
                     Background="#2A2A2A" Foreground="#CCCCCC" BorderBrush="#333333"
                     Padding="6,4" FontSize="13"/>

            <!-- Path -->
            <TextBlock Grid.Row="6" Text="Path" Foreground="#999999" FontSize="12"/>
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="PathBox"
                         Background="#2A2A2A" Foreground="#CCCCCC" BorderBrush="#333333"
                         Padding="6,4" FontSize="13"/>
                <Button Grid.Column="2" Content="..." Width="32"
                        Background="#2A2A2A" Foreground="#CCCCCC" BorderBrush="#333333"
                        Click="OnBrowseClick"/>
            </Grid>

            <!-- Type -->
            <TextBlock Grid.Row="10" Text="Type" Foreground="#999999" FontSize="12"/>
            <ComboBox Grid.Row="10" x:Name="TypeCombo" HorizontalAlignment="Right" Width="120"
                      Background="#2A2A2A" Foreground="#CCCCCC" BorderBrush="#333333"
                      FontSize="13" Padding="6,4"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Padding="6"
                        Background="#2A2A2A" Foreground="#CCCCCC" BorderBrush="#333333"
                        Click="OnCancelClick" Margin="0,0,8,0"/>
                <Button Content="Save" Width="80" Padding="6"
                        Background="#2196F3" Foreground="White" BorderBrush="#1976D2"
                        Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
