<Window x:Class="SidebarLauncher.EditShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Shortcut"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="360" Height="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Dark ComboBox style -->
        <ControlTemplate x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="#2A2A2A" BorderBrush="#555555" BorderThickness="1" CornerRadius="0"/>
                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#AAAAAA"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </ControlTemplate>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DarkComboBoxToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,4,24,4" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#2A2A2A" BorderBrush="#555555" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#2A2A2A"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2196F3"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#E6181818" CornerRadius="8"
            BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" Opacity="0.4" ShadowDepth="2" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <TextBlock Grid.Row="0" Text="Add Shortcut" FontSize="16" FontWeight="SemiBold"
                       Foreground="#CCCCCC" x:Name="TitleText"/>

            <!-- Name -->
            <TextBlock Grid.Row="2" Text="Name" Foreground="#BBBBBB" FontSize="12"/>
            <TextBox Grid.Row="4" x:Name="NameBox"
                     Background="#2A2A2A" Foreground="White" BorderBrush="#555555"
                     Padding="6,4" FontSize="13"/>

            <!-- Path / Command -->
            <TextBlock Grid.Row="6" x:Name="PathLabel" Text="Path" Foreground="#BBBBBB" FontSize="12"/>
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="PathBox"
                         Background="#2A2A2A" Foreground="White" BorderBrush="#555555"
                         Padding="6,4" FontSize="13"/>
                <Button Grid.Column="2" x:Name="BrowseButton" Content="..." Width="32"
                        Background="#2A2A2A" Foreground="White" BorderBrush="#555555"
                        Click="OnBrowseClick"/>
            </Grid>

            <!-- Icon -->
            <TextBlock Grid.Row="10" Text="Icon" Foreground="#BBBBBB" FontSize="12"/>
            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="IconPathBox"
                         Background="#2A2A2A" Foreground="#999999" BorderBrush="#555555"
                         Padding="6,4" FontSize="11" IsReadOnly="True"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="..." Width="32"
                        Background="#2A2A2A" Foreground="White" BorderBrush="#555555"
                        Click="OnBrowseIconClick" ToolTip="Browse for icon"/>
                <Button Grid.Column="4" Content="X" Width="24"
                        Background="#2A2A2A" Foreground="#FF6666" BorderBrush="#555555"
                        Click="OnClearIconClick" ToolTip="Use default icon" FontSize="11"/>
            </Grid>

            <!-- Type -->
            <TextBlock Grid.Row="12" Text="Type" Foreground="#BBBBBB" FontSize="12"/>
            <ComboBox Grid.Row="12" x:Name="TypeCombo" HorizontalAlignment="Right" Width="120"
                      Style="{StaticResource DarkComboBox}"/>

            <!-- Terminal options -->
            <CheckBox Grid.Row="14" x:Name="NewTabCheck"
                      Content="Open as new tab in Windows Terminal"
                      Foreground="#BBBBBB" FontSize="12"
                      Visibility="Collapsed"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="16" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Padding="6"
                        Background="#2A2A2A" Foreground="White" BorderBrush="#555555"
                        Click="OnCancelClick" Margin="0,0,8,0"/>
                <Button Content="Save" Width="80" Padding="6"
                        Background="#2196F3" Foreground="White" BorderBrush="#1976D2"
                        Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
