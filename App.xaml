<Application x:Class="SidebarLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#181818"/>
        <SolidColorBrush x:Key="BgMedium" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="BorderDark" Color="#333333"/>
        <SolidColorBrush x:Key="TextDim" Color="#999999"/>
        <SolidColorBrush x:Key="TextLight" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2196F3"/>
    </Application.Resources>
</Application>
