<Window x:Class="SidebarLauncher.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        MouseLeave="OnMouseLeave"
        MouseEnter="OnMouseEnter">
    <Window.RenderTransform>
        <TranslateTransform x:Name="SlideTransform"/>
    </Window.RenderTransform>

    <Border x:Name="OuterBorder"
            CornerRadius="0,8,8,0"
            BorderThickness="0,1,1,1"
            BorderBrush="#40FFFFFF">
        <Border.Background>
            <SolidColorBrush Color="#181818" Opacity="0.92"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.5" ShadowDepth="3" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Shortcut icons list -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnScrollWheel">
                <ItemsControl x:Name="ShortcutList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ItemBorder"
                                    Width="{Binding BarWidth}"
                                    Height="{Binding BarWidth}"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnShortcutClick"
                                    MouseRightButtonUp="OnShortcutRightClick"
                                    ToolTipService.InitialShowDelay="300">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                            <TextBlock Text="{Binding Path}" Foreground="#999999" FontSize="11"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#30FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding Icon}"
                                       Width="{Binding IconSize}"
                                       Height="{Binding IconSize}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Separator line above add button -->
            <Rectangle Grid.Row="1" Height="1" Fill="#30FFFFFF" VerticalAlignment="Top"/>

            <!-- Add button at bottom -->
            <Border Grid.Row="1"
                    Width="48" Height="48"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnAddClick"
                    Margin="0,1,0,0"
                    ToolTip="Add shortcut">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="+"
                           FontSize="24"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
