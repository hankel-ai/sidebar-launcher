<Window x:Class="SidebarLauncher.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SidebarLauncher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        MouseLeave="OnMouseLeave"
        MouseEnter="OnMouseEnter"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        DragOver="OnDragOver"
        Drop="OnDrop"
        DragLeave="OnDragLeave">

    <Window.RenderTransform>
        <TranslateTransform x:Name="SlideTransform"/>
    </Window.RenderTransform>

    <Border x:Name="OuterBorder"
            CornerRadius="0,8,8,0"
            BorderThickness="0,1,1,1"
            BorderBrush="#40FFFFFF"
            MouseRightButtonUp="OnBarRightClick">
        <Border.Background>
            <SolidColorBrush Color="#181818" Opacity="0.92"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.5" ShadowDepth="3" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Grid of slots -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnScrollWheel">
                <Canvas x:Name="SlotCanvas" ClipToBounds="True"/>
            </ScrollViewer>

            <!-- Bottom bar: lock indicator + add button -->
            <StackPanel Grid.Row="1">
                <Rectangle Height="1" Fill="#30FFFFFF"/>
                <Border Width="48" Height="48"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonUp="OnAddClick"
                        ToolTip="Add shortcut">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#30FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="+"
                               FontSize="24"
                               Foreground="#999999"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
