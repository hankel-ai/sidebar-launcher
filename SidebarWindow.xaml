<Window x:Class="SidebarLauncher.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SidebarLauncher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        MouseLeave="OnMouseLeave"
        MouseEnter="OnMouseEnter"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        DragOver="OnDragOver"
        Drop="OnDrop"
        DragLeave="OnDragLeave">

    <Window.RenderTransform>
        <TranslateTransform x:Name="SlideTransform"/>
    </Window.RenderTransform>

    <Border x:Name="OuterBorder"
            CornerRadius="0,8,8,0"
            BorderThickness="0,1,1,1"
            BorderBrush="#40FFFFFF"
            MouseRightButtonUp="OnBarRightClick"
            PreviewMouseLeftButtonDown="OnBarDoubleClick">
        <Border.Background>
            <SolidColorBrush Color="#181818" Opacity="0.92"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.5" ShadowDepth="3" Color="Black"/>
        </Border.Effect>

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="OnScrollWheel">
            <Canvas x:Name="SlotCanvas" ClipToBounds="True"/>
        </ScrollViewer>
    </Border>
</Window>
